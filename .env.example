# Final production origin, with no path or trailing content.
NEXT_PUBLIC_SITE_URL=https://guildframe.com

# Optional until GA4 is ready.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity public project ID for session recordings and heatmaps.
NEXT_PUBLIC_CLARITY_PROJECT_ID=xp0rrg52qu

# Optional when Search Console ownership is verified with a DNS TXT record.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sender hosted form; restrict signup delivery to the configured kit flow.
NEXT_PUBLIC_SENDER_LAUNCH_KIT_FORM_URL=
# Optional native Sender iframe URL. Leave blank when using the hosted form.
NEXT_PUBLIC_SENDER_LAUNCH_KIT_EMBED_URL=
