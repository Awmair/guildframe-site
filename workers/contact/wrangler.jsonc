{
  "name": "guildframe-contact",
  "main": "index.ts",
  "account_id": "0e4a8755a4057e51ab1e90386b0b008c",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "guildframe.com/api/contact", "zone_name": "guildframe.com" }],
  "vars": { "ALLOWED_ORIGIN": "https://guildframe.com" },
  "send_email": [{
    "name": "EMAIL",
    "allowed_destination_addresses": ["umair@guildframe.com"],
    "allowed_sender_addresses": ["enquiries@forms.guildframe.com"]
  }],
  "ratelimits": [{
    "name": "CONTACT_RATE_LIMIT",
    "namespace_id": "9751002",
    "simple": { "limit": 3, "period": 60 }
  }],
  "observability": { "enabled": false }
}
